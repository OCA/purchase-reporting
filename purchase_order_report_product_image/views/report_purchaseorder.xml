<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        id="report_purchaseorder_document_image"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <th name="th_description" position="before">
            <th name="th_image">Image</th>
        </th>

        <xpath expr="//td[@id='product']" position="before">
            <td name="td_image">
                <span
                    t-field="line.product_id.image_128"
                    t-options="{'widget': 'image', 'max_width': '64', 'class': 'rounded'}"
                />
            </td>
        </xpath>
    </template>

    <template
        id="report_purchasequotation_document_image"
        inherit_id="purchase.report_purchasequotation_document"
    >
        <th name="th_description" position="before">
            <th name="th_image">Image</th>
        </th>
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_image">
                <span
                    t-field="order_line.product_id.image_128"
                    t-options="{'widget': 'image', 'max_width': '64', 'class': 'rounded'}"
                />
            </td>
        </xpath>
    </template>

</odoo>
