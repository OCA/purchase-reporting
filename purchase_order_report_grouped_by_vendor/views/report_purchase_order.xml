<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_purchase_order" model="ir.actions.report">
        <field name="name">Purchase Order Grouped By Vendor</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >purchase_order_report_grouped_by_vendor.report_purchase_order_grouped_by_vendor</field>
        <field
            name="report_file"
        >purchase_order_report_grouped_by_vendor.report_purchase_order_grouped_by_vendor</field>
        <field name="print_report_name">
            (object.state in ('draft', 'sent') and 'Request for Quotation - %s' % (object.name) or
            'Purchase Order - %s' % (object.name))</field>
        <field name="binding_model_id" ref="model_purchase_order" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_purchase_order_grouped_by_vendor_document">
        <!-- `o` feeds the standard layout (company resolution, article markers) -->
        <t t-set="o" t-value="group['order_ids'][:1]" />
        <t t-set="currency" t-value="o.currency_id" />
        <t t-call="web.external_layout">
            <div class="page">
                <div id="vendor" class="mb-4 row align-items-end">
                    <h3
                        class="col-9"
                        t-out="group['partner']"
                        t-options='{"widget": "contact", "fields": ["name"]}'
                    />
                    <small
                        class="col-3"
                        t-out="group['partner']"
                        t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True, "phone_icons": True}'
                    />
                </div>
                <table class="o_has_total_table table o_main_table table-borderless">
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_description" class="text-start">
                                <strong>Description</strong>
                            </th>
                            <th name="th_taxes" class="text-end">
                                <strong>Taxes</strong>
                            </th>
                            <th name="th_quantity" class="text-end">
                                <strong>Qty</strong>
                            </th>
                            <th name="th_date_planned" class="text-end">
                                <strong>Receipt Date</strong>
                            </th>
                            <th name="th_price_unit" class="text-end">
                                <strong>Unit Price</strong>
                            </th>
                            <th name="th_subtotal" class="text-end">
                                <strong>Amount</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="group['order_ids']" t-as="order">
                            <tr>
                                <td id="order_ref" colspan="6">
                                    <strong>Order: <t t-out="order.name" /></strong>
                                    <strong t-if="order.partner_ref">/ Vendor Ref: <t
                                        t-out="order.partner_ref"
                                    /></strong>
                                </td>
                            </tr>
                            <t
                                t-foreach="order.order_line.filtered(lambda line: not line.display_type)"
                                t-as="line"
                            >
                                <tr>
                                    <td id="product" class="text-start">
                                        <span t-field="line.name" />
                                    </td>
                                    <td name="td_taxes" class="text-end">
                                        <span
                                            t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.product_qty" />
                                        <span
                                            t-field="line.product_uom_id.name"
                                            groups="uom.group_uom"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <span
                                            t-field="line.date_planned"
                                            t-options="{'widget': 'datetime', 'date_only': True, 'format': 'dd/MM/YY'}"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_unit" />
                                    </td>
                                    <td class="text-end">
                                        <span
                                            t-field="line.price_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": line.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <tr>
                            <td colspan="5" class="text-end">
                                <strong>Total:</strong>
                            </td>
                            <td class="text-end">
                                <span
                                    t-out="sum(line.price_subtotal for order in group['order_ids'] for line in order.order_line)"
                                    t-options='{"widget": "monetary", "display_currency": currency}'
                                />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_purchase_order_grouped_by_vendor">
        <t t-call="web.html_container">
            <t t-foreach="docs.get_grouped_data()" t-as="group">
                <t
                    t-call="purchase_order_report_grouped_by_vendor.report_purchase_order_grouped_by_vendor_document"
                    t-lang="group['partner'].lang"
                />
            </t>
        </t>
    </template>
</odoo>
